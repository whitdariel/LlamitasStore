@model LlamitasStore.Services.Catalogo.PrecioCalculado
<div class="ls-precio">
    <span class="ls-precio-final">@Tienda.Dinero(Model.PrecioFinal)</span>
    @if (Model.TieneDescuento)
    {
        <span class="ls-precio-lista"><span class="visually-hidden">Antes </span>@Tienda.Dinero(Model.PrecioLista)</span>
        <span class="badge ls-badge-descuento">-@Model.PorcentajeDescuento%</span>
    }
</div>
