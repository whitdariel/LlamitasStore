@using LlamitasStore.Services.Cuentas
@using LlamitasStore.Services.Ventas
@inject FavoritosDelUsuario Favoritos
@inject ServicioCarrito Carrito
@inject CarritoActual CarritoActual
@inject LlamitasStore.Infraestructura.ServicioPermisos Permisos
@inject LlamitasStore.Services.Comunidad.ServicioNotificaciones Notificaciones
@inject Microsoft.AspNetCore.Identity.UserManager<Usuario> Usuarios
@{
    var rutaActual = Context.Request.Path + Context.Request.QueryString;
    var enCarrito = await Carrito.ContarAsync(CarritoActual.Dueno());
}
<a class="ls-boton-icono position-relative" href="/carrito" aria-label="Carrito (@enCarrito productos)" data-enlace-carrito>
    <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#carrito"></use></svg>
    <span class="ls-contador ls-numero @(enCarrito == 0 ? "d-none" : "")" data-contador-carrito>@enCarrito</span>
</a>
@if (User.Identity?.IsAuthenticated == true)
{
    var nombre = User.FindFirst(LlamitasStore.Infraestructura.UsuarioClaimsFactory.ClaimNombre)?.Value ?? "Mi cuenta";
    var totalFavoritos = (await Favoritos.IdsAsync()).Count;
    var sinLeer = int.TryParse(Usuarios.GetUserId(User), out var uid) ? await Notificaciones.ContarNoLeidasAsync(uid) : 0;

    <a class="ls-boton-icono position-relative" href="/cuenta/notificaciones" aria-label="Notificaciones (@sinLeer sin leer)">
        <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#campana"></use></svg>
        <span class="ls-contador ls-numero @(sinLeer == 0 ? "d-none" : "")">@(sinLeer > 99 ? "99+" : sinLeer.ToString())</span>
    </a>

    <a class="ls-boton-icono position-relative" href="/cuenta/favoritos" aria-label="Favoritos (@totalFavoritos)">
        <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#corazon"></use></svg>
        <span class="ls-contador ls-numero @(totalFavoritos == 0 ? "d-none" : "")" data-contador-favoritos>@totalFavoritos</span>
    </a>
    <div class="dropdown">
        <button class="ls-boton-cuenta" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#usuario"></use></svg>
            <span class="d-none d-xl-inline text-truncate">@nombre</span>
            <svg class="ls-icono d-none d-xl-inline" aria-hidden="true"><use href="/images/iconos.svg#chevron-abajo"></use></svg>
            <span class="visually-hidden">Menú de la cuenta de @nombre</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><h2 class="dropdown-header text-uppercase">Hola, @nombre</h2></li>
            @if (await Permisos.PuedeEntrarAlPanelAsync(User))
            {
                <li><a class="dropdown-item fw-semibold" href="/admin">Panel de administración</a></li>
                <li><hr class="dropdown-divider" /></li>
            }
            <li><a class="dropdown-item" href="/cuenta">Mi cuenta</a></li>
            <li><a class="dropdown-item" href="/cuenta/pedidos">Mis pedidos</a></li>
            <li><a class="dropdown-item" href="/cuenta/notificaciones">Notificaciones@(sinLeer > 0 ? $" ({sinLeer})" : "")</a></li>
            <li><a class="dropdown-item" href="/cuenta/favoritos">Favoritos</a></li>
            <li><a class="dropdown-item" href="/cuenta/direcciones">Direcciones</a></li>
            <li><a class="dropdown-item" href="/cuenta/seguridad">Seguridad</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form method="post" action="/cuenta/logout" asp-antiforgery="true">
                    <button type="submit" class="dropdown-item">Cerrar sesión</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="ls-boton-cuenta" href="/cuenta/login?returnUrl=@Uri.EscapeDataString(rutaActual)">
        <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#usuario"></use></svg>
        <span class="d-none d-sm-inline">Ingresar</span>
    </a>
}
