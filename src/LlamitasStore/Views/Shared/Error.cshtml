@model ErrorViewModel
@{
    var (titulo, mensaje) = Model.Texto;
    ViewData["Title"] = titulo;
}

<section class="text-center py-5">
    <img src="~/images/llamita-mark.svg" asp-append-version="true" alt="" width="96" height="96" class="mb-3" />
    <p class="text-muted mb-1">Error @Model.Codigo</p>
    <h1 class="h2">@titulo</h1>
    <p class="text-muted">@mensaje</p>
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    @if (Model.ShowRequestId && Model.Codigo >= 500)
    {
        <p class="small text-muted mt-4 mb-0">Código de seguimiento: <code>@Model.RequestId</code></p>
    }
</section>
