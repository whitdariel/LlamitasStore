@{
    ViewData["Title"] = "Privacidad";
    ViewData["Descripcion"] = "Qué datos guarda LlamitasStore y para qué.";
    var email = Tienda.Obtener(ClavesAjuste.EmailContacto);
}

<div class="ls-contenedor py-5">
    <article class="mx-auto ls-texto-legal">
        <p class="ls-eyebrow">Información</p>
        <h1 class="ls-titulo-seccion mb-4">Privacidad</h1>

        <h2 class="h5 mt-4">Qué datos guardamos</h2>
        <ul>
            <li><strong>Cuenta:</strong> nombre, apellido, correo y, si lo indicas, teléfono. La contraseña se guarda cifrada con un hash; nunca en texto plano.</li>
            <li><strong>Pedidos:</strong> productos, montos y la dirección de envío que elijas.</li>
            <li><strong>Pagos:</strong> solo el método y, en transferencias, el número de comprobante. No guardamos números de tarjeta ni datos bancarios.</li>
        </ul>

        <h2 class="h5 mt-4">Cookies y almacenamiento del navegador</h2>
        <ul>
            <li><strong>Sesión:</strong> mantiene tu sesión iniciada.</li>
            <li><strong>Seguridad (CSRF):</strong> protege los formularios contra envíos falsificados.</li>
            <li><strong>Tema:</strong> recuerda en tu navegador si prefieres el tema claro u oscuro.</li>
        </ul>
        <p>No usamos cookies de publicidad ni de seguimiento de terceros.</p>

        <h2 class="h5 mt-4">Tus derechos</h2>
        <p>
            Puedes pedir una copia de tus datos o su eliminación
            @if (!string.IsNullOrEmpty(email)) { <text>escribiendo a <a href="mailto:@email">@email</a></text> } else { <text>contactando a la tienda</text> }.
        </p>
    </article>
</div>
