@model RestablecerContrasenaVm
@{
    Layout = "_LayoutAutenticacion";
    ViewData["Title"] = "Nueva contraseña";
}

<p class="ls-eyebrow mb-1">Último paso</p>
<h1 class="ls-titulo-seccion mb-4">Nueva contraseña</h1>

<form asp-action="RestablecerContrasena" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="ls-errores" role="alert"></div>
    <input type="hidden" asp-for="Token" />
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" readonly />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
        <p class="form-text text-body-secondary mb-0">Mínimo 8 caracteres, con mayúscula, minúscula y número.</p>
        <span asp-validation-for="Password" class="ls-error-campo"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="ls-error-campo"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Guardar contraseña</button>
</form>
