@model OlvideContrasenaVm
@{
    Layout = "_LayoutAutenticacion";
    ViewData["Title"] = "Recuperar contraseña";
}

<p class="ls-eyebrow mb-1">Sin problema</p>
<h1 class="ls-titulo-seccion mb-3">Recuperar contraseña</h1>
<p class="text-body-secondary mb-4">Escribe el correo de tu cuenta y te enviaremos un enlace para crear una contraseña nueva.</p>

<form asp-action="OlvideContrasena" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="ls-errores" role="alert"></div>
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="ls-error-campo"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Enviar enlace</button>
</form>

<p class="text-center text-body-secondary mt-4 mb-0"><a asp-action="Login">Volver a ingresar</a></p>
