<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LlamitasStore</RootNamespace>
    <UserSecretsId>llamitasstore-pro-4c1f0d2e</UserSecretsId>
  </PropertyGroup>

  <!--
    Pomelo 9.0.0 es el proveedor MySQL/MariaDB más reciente y exige EF Core 9.0.x,
    por eso EF Core e Identity.EntityFrameworkCore se fijan en 9.0.23 (se ejecutan sobre el runtime .NET 10).
  -->
  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- Pomelo trae MySqlConnector 2.4.0, vulnerable a GHSA-473q-m89c-ghf8 (corregido en 2.6.1). -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.23" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LlamitasStore.Tests" />
  </ItemGroup>

</Project>
