@model List<FilaPermiso>
@inject ServicioPermisos Permisos
@{
    var rol = (Rol)ViewData["Rol"]!;
    ViewData["Title"] = $"Permisos · {rol.Name}";
    var fijo = rol.Name == Roles.Administrador;
    var editar = !fijo && await Permisos.TieneAsync(User, Modulos.Usuarios, AccionPermiso.Editar);
}
<a class="btn btn-link btn-sm px-0 mb-2" href="/admin/usuarios/roles">← Roles</a>
@if (fijo) { <div class="alert alert-secondary">El Administrador tiene acceso total y no se puede restringir.</div> }
<form method="post" action="/admin/usuarios/roles/@rol.Id/permisos" asp-antiforgery="true" class="ls-panel p-0">
    <table class="table align-middle mb-0 ls-tabla-admin ls-matriz">
        <caption class="px-3">Crear, editar o eliminar incluyen automáticamente leer.</caption>
        <thead><tr><th scope="col">Módulo</th><th scope="col">Leer</th><th scope="col">Crear</th><th scope="col">Editar</th><th scope="col">Eliminar</th></tr></thead>
        <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <th scope="row">@f.Nombre<input type="hidden" name="moduloId" value="@f.ModuloId" /></th>
                    @foreach (var (accion, valor) in new[] { ("leer", f.Leer || fijo), ("crear", f.Crear || fijo), ("editar", f.Editar || fijo), ("eliminar", f.Eliminar || fijo) })
                    {
                        <td><input class="form-check-input" type="checkbox" name="@accion" value="@f.ModuloId" checked="@valor" disabled="@(!editar)" aria-label="@accion en @f.Nombre" /></td>
                    }
                </tr>
            }
        </tbody>
    </table>
    @if (editar) { <div class="p-3"><button type="submit" class="btn btn-primary">Guardar permisos</button></div> }
</form>
