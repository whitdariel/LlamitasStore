@model MarcaFormVm
@{
    ViewData["Title"] = Model.Id is null ? "Nueva marca" : "Editar marca";
    var accion = Model.Id is null ? "/admin/marcas/nueva" : $"/admin/marcas/{Model.Id}";
}
<a class="btn btn-link btn-sm px-0 mb-2" href="/admin/marcas">← Volver</a>
<form method="post" action="@accion" asp-antiforgery="true" novalidate class="ls-panel ls-form-admin">
    <div asp-validation-summary="ModelOnly" class="ls-errores" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="ls-error-campo"></span></div>
        <div class="col-md-6"><label asp-for="SitioWeb" class="form-label"></label><input asp-for="SitioWeb" class="form-control" placeholder="https://" /><span asp-validation-for="SitioWeb" class="ls-error-campo"></span></div>
        <div class="col-12"><label asp-for="Descripcion" class="form-label"></label><input asp-for="Descripcion" class="form-control" /></div>
        <div class="col-12">
            <div class="form-check"><input asp-for="Destacada" class="form-check-input" /><label asp-for="Destacada" class="form-check-label"></label></div>
            <div class="form-check"><input asp-for="Activa" class="form-check-input" /><label asp-for="Activa" class="form-check-label"></label></div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
</form>
