@model List<MensajeContacto>
@inject ServicioPermisos Permisos
@{
    ViewData["Title"] = "Mensajes de contacto";
    var editar = await Permisos.TieneAsync(User, Modulos.Mensajes, AccionPermiso.Editar);
}
<p class="text-body-secondary">Mensajes enviados desde la página de contacto de la tienda. Los pendientes aparecen primero.</p>
<div class="ls-panel p-0">
    <ul class="list-unstyled mb-0 ls-lista-admin">
        @if (Model.Count == 0) { <li class="text-body-secondary p-3">No hay mensajes.</li> }
        @foreach (var m in Model)
        {
            <li class="align-items-start">
                <span>
                    <strong>@m.Asunto</strong> @if (!m.Atendido) { <span class="ls-estado ls-estado-pendiente ms-1">Pendiente</span> }
                    <small class="d-block text-body-secondary">@m.Nombre · <a href="mailto:@m.Email">@m.Email</a> · @m.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    <span class="d-block mt-1 ls-texto-largo">@m.Mensaje</span>
                </span>
                @if (editar)
                {
                    <form method="post" action="/admin/mensajes/@m.Id/atendido" asp-antiforgery="true">
                        <input type="hidden" name="atendido" value="@(!m.Atendido ? "true" : "false")" />
                        <button class="btn btn-outline-secondary btn-sm text-nowrap" type="submit">@(m.Atendido ? "Marcar pendiente" : "Marcar atendido")</button>
                    </form>
                }
            </li>
        }
    </ul>
</div>
