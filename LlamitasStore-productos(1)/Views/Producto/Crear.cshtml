@model Producto
@{
    ViewData["Title"] = "Registrar producto";
}

<h1 class="h3 mb-3">Registrar producto</h1>

<form method="post" asp-action="Crear" class="card card-body" style="max-width: 52rem;">
    <partial name="_Campos" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
    <p class="small text-muted mt-3 mb-0">
        El stock empieza en 0 y sube automáticamente al registrar ingresos de inventario.
    </p>
</form>
