@model List<(Marca Marca, int Productos)>
@inject ServicioPermisos Permisos
@{
    ViewData["Title"] = "Marcas";
    var crear = await Permisos.TieneAsync(User, Modulos.Marcas, AccionPermiso.Crear);
    var editar = await Permisos.TieneAsync(User, Modulos.Marcas, AccionPermiso.Editar);
    var eliminar = await Permisos.TieneAsync(User, Modulos.Marcas, AccionPermiso.Eliminar);
}
<div class="ls-admin-cabecera">
    <p class="text-body-secondary mb-0">@Model.Count marca(s)</p>
    @if (crear) { <a class="btn btn-primary btn-sm" href="/admin/marcas/nueva">Nueva marca</a> }
</div>
<div class="ls-panel p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0 ls-tabla-admin">
            <thead><tr><th scope="col">Marca</th><th scope="col" class="text-end">Productos</th><th scope="col">Inicio</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
            <tbody>
                @foreach (var (m, n) in Model)
                {
                    <tr>
                        <td><strong>@m.Nombre</strong><small class="d-block text-body-secondary">@m.Descripcion</small></td>
                        <td class="text-end ls-numero">@n</td>
                        <td>@(m.Destacada ? "Destacada" : "—")</td>
                        <td><span class="ls-estado @(m.Activa ? "ls-estado-entregado" : "ls-estado-cancelado")">@(m.Activa ? "Activa" : "Inactiva")</span></td>
                        <td class="text-end text-nowrap">
                            @if (editar) { <a class="btn btn-outline-secondary btn-sm" href="/admin/marcas/@m.Id">Editar</a> }
                            @if (eliminar && n == 0)
                            {
                                <form method="post" action="/admin/marcas/@m.Id/eliminar" asp-antiforgery="true" class="d-inline" data-confirmar="¿Eliminar la marca «@m.Nombre»?"><button class="btn btn-link btn-sm text-body-secondary" type="submit">Eliminar</button></form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
