@model ProveedorFormVm
@{
    ViewData["Title"] = Model.Id is null ? "Nuevo proveedor" : "Editar proveedor";
    var accion = Model.Id is null ? "/admin/proveedores/nuevo" : $"/admin/proveedores/{Model.Id}";
}
<a class="btn btn-link btn-sm px-0 mb-2" href="/admin/proveedores">← Volver</a>
<form method="post" action="@accion" asp-antiforgery="true" novalidate class="ls-panel ls-form-admin">
    <div asp-validation-summary="ModelOnly" class="ls-errores" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-8"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="ls-error-campo"></span></div>
        <div class="col-md-4"><label asp-for="Nit" class="form-label"></label><input asp-for="Nit" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control" type="tel" /><span asp-validation-for="Telefono" class="ls-error-campo"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="ls-error-campo"></span></div>
        <div class="col-12"><label asp-for="Direccion" class="form-label"></label><input asp-for="Direccion" class="form-control" /></div>
        <div class="col-12"><div class="form-check"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div></div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
</form>
