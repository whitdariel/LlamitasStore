@model RegistroVm
@{
    Layout = "_LayoutAutenticacion";
    ViewData["Title"] = "Crear cuenta";
}

<p class="ls-eyebrow mb-1">Es gratis</p>
<h1 class="ls-titulo-seccion mb-4">Crear cuenta</h1>

<form asp-action="Registro" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="ls-errores" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" autocomplete="given-name" autofocus />
            <span asp-validation-for="Nombre" class="ls-error-campo"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="Apellido" class="form-label"></label>
            <input asp-for="Apellido" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="Apellido" class="ls-error-campo"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="ls-error-campo"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="ayuda-password" />
        <p id="ayuda-password" class="form-text text-body-secondary mb-0">Mínimo 8 caracteres, con mayúscula, minúscula y número.</p>
        <span asp-validation-for="Password" class="ls-error-campo"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="ls-error-campo"></span>
    </div>
    <div class="form-check mb-4">
        <input asp-for="AceptaPrivacidad" class="form-check-input" />
        <label asp-for="AceptaPrivacidad" class="form-check-label">
            Acepto la <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">política de privacidad</a>
        </label>
        <span asp-validation-for="AceptaPrivacidad" class="ls-error-campo d-block"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Crear mi cuenta</button>
</form>

<p class="text-center text-body-secondary mt-4 mb-0">
    ¿Ya tienes cuenta? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Ingresa</a>
</p>
