@{
    ViewData["Title"] = "Inicio";
}

<div class="home-page">
    <section class="home-hero">
        <div class="home-hero-copy">
            <span class="home-kicker"><span class="kicker-spark">✦</span> BIENVENIDO A LLAMITAS STORE</span>
            <h1>Enciende tu<br /><span>próximo setup.</span></h1>
            <p>Componentes, accesorios y todo lo que necesitas para llevar tus ideas más lejos.</p>
            <div class="home-hero-actions">
                <a class="home-button home-button-primary" asp-controller="Home" asp-action="Categoria">Explorar categorías <span>↗</span></a>
                <a class="home-button home-button-secondary" asp-controller="Home" asp-action="Marca">Ver marcas</a>
            </div>
            <div class="home-hero-note"><span></span> Tecnología para cada forma de jugar y crear</div>
        </div>
        <div class="home-hero-visual" aria-label="Llamita gamer junto a componentes de computadora">
            <div class="hero-glow"></div>
            <div class="hero-ring hero-ring-one"></div>
            <div class="hero-ring hero-ring-two"></div>
            <img src="~/images/llamita-hero.svg" asp-append-version="true" alt="Llamita con audífonos junto a una computadora gamer" class="hero-llama" />
            <span class="hero-spark hero-spark-one">✦</span>
            <span class="hero-spark hero-spark-two">✧</span>
            <span class="hero-bubble">Tu aventura<br /><strong>comienza aquí</strong></span>
        </div>
        <div class="hero-pagination" aria-hidden="true"><span class="is-current"></span><span></span><span></span></div>
    </section>

    <section class="home-section">
        <div class="home-section-heading">
            <div>
                <span class="home-eyebrow">HECHO PARA TU MUNDO</span>
                <h2>¿Qué estás buscando?</h2>
            </div>
            <a asp-controller="Home" asp-action="Categoria" class="home-text-link">Ver categorías <span>↗</span></a>
        </div>

        <div class="home-promo-grid">
            <a class="home-promo-card promo-components" asp-controller="Home" asp-action="Categoria">
                <span class="promo-overline">POTENCIA PARA TUS IDEAS</span>
                <h3>Arma algo<br />increíble.</h3>
                <span class="promo-link">Componentes <b>↗</b></span>
                <img src="~/images/llamita-tech.svg" asp-append-version="true" alt="Llamita junto a un teclado iluminado" />
            </a>
            <a class="home-promo-card promo-brands" asp-controller="Home" asp-action="Marca">
                <span class="promo-overline">TUS FAVORITAS, AQUÍ</span>
                <h3>Marcas que<br />van contigo.</h3>
                <span class="promo-link">Descubrir marcas <b>↗</b></span>
                <img src="~/images/llamita-shop.svg" asp-append-version="true" alt="Llamita con una bolsa de compras" />
            </a>
            <a class="home-promo-card promo-orders" asp-controller="Home" asp-action="OrdenCompra">
                <span class="promo-overline">TODO EN UN SOLO LUGAR</span>
                <h3>Tu tienda<br />en marcha.</h3>
                <span class="promo-link">Ver órdenes <b>↗</b></span>
                <img src="~/images/llamita-mark.svg" asp-append-version="true" alt="Ilustración de una llamita" />
            </a>
        </div>
    </section>

    <section class="home-bottom-banner">
        <div class="bottom-banner-copy">
            <span class="home-eyebrow">PEQUEÑAS LLAMAS, GRANDES IDEAS</span>
            <h2>Encuentra lo que<br />enciende tu pasión.</h2>
            <p>Explora la tienda y prepara tu próximo proyecto.</p>
            <a asp-controller="Home" asp-action="Categoria" class="bottom-banner-link">Empezar a explorar <span>→</span></a>
        </div>
        <div class="bottom-banner-art">
            <span class="bottom-star bottom-star-one">✦</span>
            <span class="bottom-star bottom-star-two">✧</span>
            <img src="~/images/llamita-shop.svg" asp-append-version="true" alt="Llamita lista para ayudarte a elegir" />
            <img src="~/images/llamita-tech.svg" asp-append-version="true" alt="Llamita con un teclado gamer" />
        </div>
        <div class="bottom-orb bottom-orb-one"></div>
        <div class="bottom-orb bottom-orb-two"></div>
    </section>
</div>
