@model IEnumerable<LlamitasStore.Models.Marca>

@{
    ViewData["Title"] = "Gestión de Marcas";
}

<div class="container mt-4">
    <h2>Marcas de Componentes</h2>
    <p class="text-muted">Administra los fabricantes de hardware para la tienda.</p>

    <button class="btn btn-primary mb-3">Nueva Marca</button>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.NombreMarca</td>
                        <td>@item.Descripcion</td>
                        <td>
                            <button class="btn btn-sm btn-warning">Editar</button>
                            <button class="btn btn-sm btn-danger">Eliminar</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>