@model IEnumerable<LlamitasStore.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container mt-4">
    <h2>Categorías de Productos</h2>
    <p class="text-muted">Clasificación del inventario de componentes de PC.</p>

    <button class="btn btn-success mb-3">Nueva Categoría</button>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.NombreCategoria</td>
                        <td>@item.Descripcion</td>
                        <td>
                            <button class="btn btn-sm btn-warning">Editar</button>
                            <button class="btn btn-sm btn-danger">Eliminar</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>