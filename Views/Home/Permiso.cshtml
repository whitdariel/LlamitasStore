@model IEnumerable<LlamitasStore.Models.Permiso>

@{
    ViewData["Title"] = "Control de Permisos";
}

<div class="container mt-4">
    <h2>Matriz de Permisos</h2>
    <p class="text-muted">Permisos registrados por Rol y Módulo.</p>

    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>ID Rol</th>
                <th>ID Módulo</th>
                <th>Leer</th>
                <th>Crear</th>
                <th>Editar</th>
                <th>Eliminar</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.IdRol</td>
                        <td>@p.IdModulo</td>
                        <td><input type="checkbox" checked="@p.PuedeLeer" disabled /></td>
                        <td><input type="checkbox" checked="@p.PuedeCrear" disabled /></td>
                        <td><input type="checkbox" checked="@p.PuedeEditar" disabled /></td>
                        <td><input type="checkbox" checked="@p.PuedeEliminar" disabled /></td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>