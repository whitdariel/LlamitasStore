@* Mensajes de una sola vez (TempData) tras una acción: éxito o error. *@
@if (TempData["Exito"] is string exito)
{
    <div class="ls-contenedor pt-3">
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-0" role="status">
            <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#escudo"></use></svg>
            <span>@exito</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar mensaje"></button>
        </div>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="ls-contenedor pt-3">
        <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
            <span>@error</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar mensaje"></button>
        </div>
    </div>
}
