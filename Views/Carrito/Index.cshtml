@model CarritoVista
@{
    ViewData["Title"] = "Carrito";
}

<div class="ls-contenedor ls-cabecera-pagina">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Carrito</li>
        </ol>
    </nav>
    <h1 class="ls-titulo-seccion mb-4">Tu carrito @if (!Model.EstaVacio) { <small class="text-body-secondary fs-6 ls-numero">(@Model.CantidadTotal)</small> }</h1>

    @if (Model.EstaVacio)
    {
        <div class="ls-panel text-center py-5">
            <svg class="ls-icono ls-icono-grande mb-2" aria-hidden="true"><use href="/images/iconos.svg#carrito"></use></svg>
            <p class="mb-3">Tu carrito está vacío.</p>
            <a class="btn btn-primary" href="/catalogo">Explorar el catálogo</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <section class="col-lg-8" aria-label="Productos del carrito">
                <ul class="list-unstyled d-grid gap-3 mb-3">
                    @foreach (var i in Model.Items)
                    {
                        <li class="ls-item-carrito @(i.Comprable ? "" : "ls-item-problema")">
                            <a class="ls-item-imagen" href="/producto/@i.Slug" tabindex="-1" aria-hidden="true">
                                @if (i.ImagenUrl is not null) { <img src="@i.ImagenUrl" alt="" width="120" height="90" loading="lazy" /> }
                            </a>
                            <div class="ls-item-info">
                                <p class="ls-tarjeta-marca mb-0">@i.Marca</p>
                                <a class="ls-item-nombre" href="/producto/@i.Slug">@i.Nombre</a>
                                <p class="small text-body-secondary mb-1">SKU @i.Sku · @Tienda.Dinero(i.Precio.PrecioFinal) c/u
                                    @if (i.Precio.TieneDescuento) { <span class="ls-badge-descuento ms-1">-@i.Precio.PorcentajeDescuento%</span> }
                                </p>
                                @if (i.SinStock)
                                {
                                    <p class="ls-stock ls-stock-agotado" role="status">Ya no está disponible: quítalo para continuar.</p>
                                }
                                else if (i.CantidadExcedeStock)
                                {
                                    <p class="ls-stock ls-stock-bajo" role="status">Solo quedan @i.Stock unidad(es): ajusta la cantidad.</p>
                                }
                            </div>
                            <div class="ls-item-acciones">
                                @if (!i.SinStock)
                                {
                                    <form method="post" action="/carrito/actualizar" asp-antiforgery="true" class="d-flex align-items-center gap-2" data-autoenvio>
                                        <input type="hidden" name="productoId" value="@i.ProductoId" />
                                        <label class="visually-hidden" for="cant-@i.ProductoId">Cantidad de @i.Nombre</label>
                                        <select id="cant-@i.ProductoId" name="cantidad" class="form-select form-select-sm ls-selector-cantidad">
                                            @for (var n = 1; n <= Math.Max(i.MaximoSeleccionable, i.Cantidad); n++)
                                            {
                                                <option value="@n" selected="@(n == i.Cantidad)" disabled="@(n > i.MaximoSeleccionable)">@n</option>
                                            }
                                        </select>
                                        <noscript><button class="btn btn-sm btn-outline-secondary" type="submit">Actualizar</button></noscript>
                                    </form>
                                }
                                <strong class="ls-numero">@Tienda.Dinero(i.Subtotal)</strong>
                                <form method="post" action="/carrito/quitar" asp-antiforgery="true">
                                    <input type="hidden" name="productoId" value="@i.ProductoId" />
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-body-secondary">Quitar</button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="/catalogo">
                        <svg class="ls-icono" aria-hidden="true"><use href="/images/iconos.svg#flecha-izq"></use></svg> Seguir comprando
                    </a>
                    <form method="post" action="/carrito/vaciar" asp-antiforgery="true" data-confirmar="¿Vaciar el carrito?">
                        <button type="submit" class="btn btn-link btn-sm text-body-secondary">Vaciar carrito</button>
                    </form>
                </div>
            </section>

            <aside class="col-lg-4" aria-label="Resumen del pedido">
                <div class="ls-panel ls-resumen">
                    <h2 class="ls-escenario-panel-titulo text-start">Resumen</h2>
                    <partial name="_ResumenTotales" model="Model" />

                    @if (Model.CuponAplicado is not null)
                    {
                        <form method="post" action="/carrito/cupon/quitar" asp-antiforgery="true" class="d-flex justify-content-between align-items-center mt-3">
                            <span class="ls-chip ls-chip-info mb-0">Cupón @Model.CuponAplicado.Codigo</span>
                            <button type="submit" class="btn btn-link btn-sm">Quitar</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="/carrito/cupon" asp-antiforgery="true" class="mt-3">
                            <label for="codigo-cupon" class="ls-filtro-titulo">¿Tienes un cupón?</label>
                            <div class="d-flex gap-2">
                                <input id="codigo-cupon" name="codigo" class="form-control form-control-sm text-uppercase" maxlength="40" autocomplete="off" value="@Model.CodigoCupon" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Aplicar</button>
                            </div>
                            @if (Model.ErrorCupon is not null) { <p class="ls-error-campo">@Model.ErrorCupon</p> }
                        </form>
                    }

                    @if (Model.PuedeComprar)
                    {
                        <a class="btn btn-primary btn-lg w-100 mt-4" href="/checkout">Finalizar compra</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-lg w-100 mt-4" disabled aria-describedby="aviso-carrito">Finalizar compra</button>
                        <p id="aviso-carrito" class="small ls-stock-bajo mt-2 mb-0">Corrige los productos marcados para continuar.</p>
                    }
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <p class="small text-body-secondary mt-2 mb-0">Te pediremos ingresar o crear tu cuenta para finalizar. Tu carrito se conserva.</p>
                    }
                </div>
            </aside>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/catalogo.js" asp-append-version="true"></script>
}
