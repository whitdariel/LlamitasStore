@using Microsoft.AspNetCore.Mvc.Rendering
@model Producto

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-12 col-md-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" required />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="IdCategoria" class="form-label"></label>
        <select asp-for="IdCategoria" asp-items="@((SelectList)ViewBag.Categorias)" class="form-select">
            <option value="0">Seleccione…</option>
        </select>
        <span asp-validation-for="IdCategoria" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" maxlength="50" />
        <span asp-validation-for="Marca" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Modelo" class="form-label"></label>
        <input asp-for="Modelo" class="form-control" maxlength="50" />
        <span asp-validation-for="Modelo" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="2" maxlength="200"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="PrecioCompra" class="form-label"></label>
        <input asp-for="PrecioCompra" type="number" step="0.01" min="0" class="form-control" required />
        <span asp-validation-for="PrecioCompra" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="PrecioVenta" class="form-label"></label>
        <input asp-for="PrecioVenta" type="number" step="0.01" min="0" class="form-control" required />
        <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-4">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" asp-items="@((SelectList)ViewBag.Estados)" class="form-select"></select>
        <span asp-validation-for="Estado" class="text-danger small"></span>
    </div>
</div>
