@model Producto
@{
    ViewData["Title"] = "Editar producto";
}

<h1 class="h3 mb-3">Editar producto <span class="text-muted">#@Model.IdProducto</span></h1>

<form method="post" asp-action="Editar" asp-route-id="@Model.IdProducto" class="card card-body" style="max-width: 52rem;">
    <partial name="_Campos" model="Model" />
    <div class="mt-3">
        <span class="small text-muted">
            Stock actual: <strong>@Model.StockActual</strong>
            (se actualiza solo con ingresos de inventario y ventas)
        </span>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
